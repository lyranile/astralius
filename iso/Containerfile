# run with --cap-add sys_admin --security-opt label=disable --squash
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ENV BASE_IMAGE=${BASE_IMAGE}

COPY system_files/ /src/system_files/
COPY build_files/ /src/build_files/

RUN --mount=type=cache,target=/var/tmp/libdnf5,id=libdnf5 \
    rsync -rvKl /src/system_files/ / && \
    bash /src/build_files/build.sh
